# MongoDB credentials
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme

# Database name
MONGODB_DB=mydb

# JWT secret — use a strong random value in production
JWT_SECRET=change-me-in-production

# API image (used in docker-compose, set your actual GHCR image here)
API_IMAGE=ghcr.io/ronanlambare/backend-mongo-api:latest

# API port exposed on the host
API_PORT=8080
